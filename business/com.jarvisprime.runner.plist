<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvisprime.runner</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>--env-file=.env</string>
        <string>src/runner.js</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Users/anujsingh/Jarvis ai company/agents</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/anujsingh</string>
    </dict>
    
    <!-- Run automatically at login -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Keep alive (restart if crashes) -->
    <key>KeepAlive</key>
    <true/>
    
    <!-- Don't start if Mac is on battery -->
    <key>StandardOutPath</key>
    <string>/Users/anujsingh/Jarvis ai company/agents/logs/stdout.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/anujsingh/Jarvis ai company/agents/logs/stderr.log</string>
    
    <!-- Throttle restarts -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
