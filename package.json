{
  "name": "jarvis-prime",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "engine"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace=apps/site",
    "dev:engine": "npm run server --workspace=engine",
    "build:site": "npm run build --workspace=apps/site",
    "test:engine": "npm run test --workspace=engine",
    "dev": "concurrently \"npm run dev:site\" \"npm run dev:engine\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
