{
  "name": "jarvis-prime",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:reset": "supabase --workdir database start && supabase --workdir database db reset",
    "db:status": "supabase --workdir database status",
    "db:push": "supabase --workdir database db push",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run server --workspace=apps/api",
    "employee:create": "npm run employee:create --workspace=apps/api",
    "owner:bootstrap": "npm run owner:bootstrap --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
