{
  "name": "@jarvis-prime/api",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "JARVIS PRIME engine — CLI + HTTP API. Finds prospects, scores, personalizes, sends sequences, handles replies. Plugin-based provider system, event-driven architecture.",
  "main": "src/runner.js",
  "scripts": {
    "run": "node src/runner.js",
    "source": "node src/runner.js --task=source",
    "outbound": "node src/runner.js --task=outbound",
    "inbound": "node src/runner.js --task=inbound",
    "doctor": "node src/runner.js --doctor",
    "server": "node src/runner.js --server",
    "server:dev": "node --watch src/runner.js --server",
    "dev": "node --watch src/runner.js --server",
    "test": "node --test",
    "test:integration:db": "node --test integration/employee-portal.postgres.integration.js",
    "test:integration:client-portal": "node --test integration/client-portal.postgres.integration.js",
    "test:integration:client-account-deletion": "node --test integration/client-account-deletion.postgres.integration.js",
    "test:integration:finance": "node --test integration/finance-billing.postgres.integration.js",
    "test:integration:communications": "node --test integration/communication-hub.postgres.integration.js",
    "employee:create": "node scripts/provision-employee.js",
    "seed:employee-portal": "node scripts/seed-employee-portal.js",
    "test:watch": "node --test --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "express": "^4.22.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "pg": "8.16.3"
  }
}
