# Local API configuration — copy to apps/api/.env. Never commit that file.
NODE_ENV=development
PORT=3001
DRY_RUN=true
SCHEDULER_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# Generate each locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTOMATION_SERVER_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

# Run `supabase --workdir database status -o env` after starting Local Supabase.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_OWNER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Disposable local accounts only. Passwords are never committed or printed by scripts.
LOCAL_OWNER_NAME=Local Owner
LOCAL_OWNER_EMAIL=local-owner@jarvis.test
LOCAL_OWNER_PASSWORD=
LOCAL_EMPLOYEE_PASSWORD=

# Keep every outbound/provider integration disabled locally.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_URL=
CALCOM_API_KEY=
LINKEDIN_COOKIE=
LINKEDIN_CSRF=
FROM_NAME=JARVIS PRIME Local
FROM_EMAIL=local@jarvis.test
REPLY_TO_EMAIL=local@jarvis.test
COMPANY_POSTAL_ADDRESS=Local development only
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe
