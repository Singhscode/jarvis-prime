# ============================================================
# JARVIS PRIME ENGINE — Environment Configuration
# Copy this file to ".env" and fill in your real values.
# Nothing here is sent anywhere except the providers you enable.
# ============================================================

# ---- SAFETY SWITCH -----------------------------------------
# DRY_RUN=true  -> full pipeline runs but NO real emails are sent
#                  and NO paid API calls are made (uses safe mocks).
# DRY_RUN=false -> goes LIVE. Only set this once your sending
#                  domain + keys are ready. See README "Go Live".
DRY_RUN=true

# How many new prospects to source per run (keep small while testing)
DAILY_PROSPECT_LIMIT=25
# How many outreach emails to send per run (deliverability-safe cap)
DAILY_SEND_LIMIT=40

# ---- DATABASE (Supabase) -----------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AUTHENTICATION (JWT) ----------------------------------
# Required for the user-facing auth layer (/api/auth/*)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ---- PROSPECT SOURCING -------------------------------------
# Apollo.io — prospect database. https://apollo.io
APOLLO_API_KEY=
# Hunter.io — email finding/verification. https://hunter.io
HUNTER_API_KEY=

# ---- AI PERSONALIZATION ------------------------------------
# Groq — fast LLM for writing personalized emails. https://groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- EMAIL SENDING -----------------------------------------
# Resend — email delivery. https://resend.com
RESEND_API_KEY=
# The from-address MUST be on a domain you control with SPF/DKIM set up.
FROM_NAME=Anuj from JARVIS PRIME
FROM_EMAIL=anuj@jarvisprime.me
# Where replies go (your real inbox)
REPLY_TO_EMAIL=anuj@jarvisprime.me

# ---- ALERTS (optional) -------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- COMPLIANCE --------------------------------------------
# Shown in every email footer (legally required for cold outreach).
COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Gurgaon, Haryana, India
# Public URL that handles one-click unsubscribe.
UNSUBSCRIBE_URL=https://www.jarvisprime.me/unsubscribe
