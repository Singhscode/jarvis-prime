# ============================================================
# JARVIS PRIME ENGINE — Test/CI Environment
# Used in GitHub Actions CI pipeline
# DRY_RUN = true (no real APIs called in CI)
# ============================================================

NODE_ENV=test

# ---- SAFETY SWITCH -----------------------------------------
# Always true in CI — prevent any real API calls
DRY_RUN=true

# Minimal limits for fast CI runs
DAILY_PROSPECT_LIMIT=1
DAILY_SEND_LIMIT=0

# ---- DATABASE (Supabase test) --------------------------------
SUPABASE_URL=https://test-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-mock

# ---- AUTHENTICATION (JWT test mock) --------------------------
JWT_SECRET=test-jwt-secret-mock-not-for-production-use

# ---- PROSPECT SOURCING (mock keys) --------------------------
APOLLO_API_KEY=test-apollo-key-mock
HUNTER_API_KEY=test-hunter-key-mock

# ---- AI PERSONALIZATION (mock keys) -------------------------
GROQ_API_KEY=test-groq-key-mock
GROQ_MODEL=llama-3.3-70b-versatile

# ---- EMAIL SENDING (disabled in tests) ---------------------
RESEND_API_KEY=test-resend-key-mock
FROM_NAME=JARVIS PRIME (TEST)
FROM_EMAIL=test@jarvisprime.me
REPLY_TO_EMAIL=test+replies@jarvisprime.me

# ---- ALERTS (disabled in tests) ----------------------------
TELEGRAM_BOT_TOKEN=test-bot-token-mock
TELEGRAM_CHAT_ID=test-chat-id-mock

# ---- COMPLIANCE (test) --------------------------------------
COMPANY_POSTAL_ADDRESS=JARVIS PRIME (TEST), Gurgaon, Haryana, India
UNSUBSCRIBE_URL=http://localhost:3001/unsubscribe

# ---- LOGGING -----------------------------------------------
LOG_LEVEL=error
