# =============================================================================
# JARVIS PRIME SITE — PRODUCTION environment template
#
# NO REAL SECRETS HERE — this file is safe to commit.
# Set real values in Vercel Dashboard → Settings → Environment Variables.
#
# Vercel injects these at build/runtime automatically.
# =============================================================================

NODE_ENV=production

# Your deployed engine URL (Render, Railway, EC2, etc.)
NEXT_PUBLIC_ENGINE_URL=REPLACE_WITH_PRODUCTION_ENGINE_URL

# Supabase
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_PRODUCTION_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PRODUCTION_ANON_KEY

# Notifications
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# AI Chat Widget
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY

# Must match engine AUTOMATION_SERVER_SECRET
AUTOMATION_SECRET=REPLACE_WITH_STRONG_SECRET
