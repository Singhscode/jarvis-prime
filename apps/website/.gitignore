# Secrets — NEVER commit actual secret files
.env
.env.local

# Allow committed safe templates
!.env.development
!.env.test
!.env.production
!.env.example

# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Logs
*.log

# OS
.DS_Store

# Netlify / Vercel
.netlify
.vercel
