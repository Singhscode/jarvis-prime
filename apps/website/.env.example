# =============================================================================
# JARVIS PRIME SITE — Environment Variables Reference
#
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your values.
# 3. Never commit .env.local — it is in .gitignore.
# =============================================================================

# ---- Engine URL ------------------------------------------------------------
# Development: your local engine server
# Production:  your deployed engine URL (set in Vercel env vars)
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001

# ---- Supabase (direct DB access from the site) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Notifications (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- AI Chat Widget (optional) --------------------------------------------
GROQ_API_KEY=

# ---- Automation Auth -------------------------------------------------------
# Must match AUTOMATION_SERVER_SECRET in engine/.env
AUTOMATION_SECRET=dev-secret-change-me

# ---- Portal Auth (server-only — no NEXT_PUBLIC_ prefix) --------------------
# Password for the /dashboard, /leads, /tasks internal portal.
# Generate a cookie signing secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_PASSWORD=
PORTAL_COOKIE_SECRET=
