# =============================================
# JARVIS PRIME — Test/CI Environment
# Used in GitHub Actions CI pipeline
# DRY_RUN = true (no real API calls in tests)
# =============================================

NODE_ENV=test

# --- Supabase (use test project or mocks) ---
NEXT_PUBLIC_SUPABASE_URL=https://test-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key-mock
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key-mock

# --- Telegram Bot Alerts (disabled in tests) ---
TELEGRAM_BOT_TOKEN=test-bot-token-mock
TELEGRAM_CHAT_ID=test-chat-id-mock

# --- Contact ---
FOUNDER_PHONE=918810500723

# --- n8n Webhook (disabled in tests) ---
N8N_WEBHOOK_URL=

# --- Test Mode ---
# Always true in CI to prevent real API calls
DRY_RUN=true

# --- Logging ---
LOG_LEVEL=error
