# =============================================
# JARVIS PRIME — Development Environment
# Used on your local machine during development
# DRY_RUN = true (safe mode, no real API calls)
# =============================================

NODE_ENV=development

# --- Supabase (use dev project if available, or test keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://dev-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key-here

# --- Telegram Bot Alerts (use test bot for dev) ---
TELEGRAM_BOT_TOKEN=dev-bot-token-here
TELEGRAM_CHAT_ID=dev-chat-id-here

# --- Contact ---
FOUNDER_PHONE=918810500723

# --- n8n Webhook (optional, leave blank if not needed) ---
N8N_WEBHOOK_URL=

# --- Development Mode ---
# Set to true to disable real API calls, use mocks instead
DRY_RUN=true

# --- Logging ---
LOG_LEVEL=debug
