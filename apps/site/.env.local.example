# =============================================
# JARVIS PRIME — Environment Variables
# Copy this file to .env.local and fill values
# NEVER commit .env.local to git
# =============================================

# --- Supabase ---
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Telegram Bot Alerts (FREE forever — no credit card) ---
# Step 1: Message @BotFather on Telegram → /newbot → copy the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Step 2: Start your bot, then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
#   Copy the "id" value from "chat" object — that is your CHAT_ID
TELEGRAM_CHAT_ID=987654321

# --- Your Contact Number (used in WhatsApp button on site) ---
# Already hardcoded in ContactSection.tsx as +91 88105 00723
FOUNDER_PHONE=918810500723

# --- n8n Webhook (OPTIONAL — only needed for outbound automation) ---
# Leave blank to skip. Only set if you have n8n running.
N8N_WEBHOOK_URL=
