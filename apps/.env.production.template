# =============================================
# JARVIS PRIME — Production Environment Template
# Add this to GitHub Environments > Production > Secrets
# NEVER commit actual values to this file
# =============================================

NODE_ENV=production

# --- Supabase (production project) ---
# Get from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://prod-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=prod-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=prod-service-role-key-here

# --- Telegram Bot Alerts (production bot) ---
# Use separate bot for production (not dev bot)
TELEGRAM_BOT_TOKEN=prod-bot-token-here
TELEGRAM_CHAT_ID=prod-chat-id-here

# --- Contact ---
FOUNDER_PHONE=918810500723

# --- n8n Webhook (if using n8n in production) ---
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/prod

# --- Production Mode ---
# MUST be false in production (real API calls enabled)
DRY_RUN=false

# --- Logging ---
LOG_LEVEL=warn
