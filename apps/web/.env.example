# Local Next.js configuration — copy to apps/web/.env.local. Never commit that file.
NEXT_PUBLIC_ENGINE_URL=http://localhost:3001

# Obtain these public local values from `supabase --workdir database status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Operations Portal gate. Generate distinct values locally; do not use real credentials.
PORTAL_PASSWORD=
PORTAL_COOKIE_SECRET=

# Optional local presentation values only.
FOUNDER_PHONE=
N8N_WEBHOOK_URL=
