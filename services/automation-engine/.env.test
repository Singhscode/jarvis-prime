# =============================================================================
# JARVIS PRIME ENGINE — TEST environment
# Used by CI/CD and local `npm test` runs.
# All external I/O is mocked — no real API calls are ever made in this env.
# =============================================================================

NODE_ENV=test

# Safety must always be ON in test
DRY_RUN=true

# Minimal limits — tests should be fast
DAILY_PROSPECT_LIMIT=3
DAILY_SEND_LIMIT=5

PORT=3002
AUTOMATION_SERVER_SECRET=test-secret-not-for-prod

# Test uses in-memory store — no real Supabase needed
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stub keys — providers detect these and use mock responses
APOLLO_API_KEY=test_apollo_key
HUNTER_API_KEY=test_hunter_key

GROQ_API_KEY=test_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

EMAIL_PROVIDER=resend
RESEND_API_KEY=test_resend_key
FROM_NAME=Test — JARVIS PRIME
FROM_EMAIL=test@jarvisprime.me
REPLY_TO_EMAIL=test@jarvisprime.me

# Notifications disabled in tests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC

CORS_ORIGINS=http://localhost:3000

COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Test Address
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe

DEFAULT_MAX_STEPS=2
DEFAULT_FOLLOWUP_DAYS=0,1
QUALIFY_THRESHOLD=15
HOT_THRESHOLD=24
