# =============================================================================
# JARVIS PRIME ENGINE — DEVELOPMENT environment
# This file is committed. It contains only safe defaults — NO real secrets.
# Real values go in your .env (local) or the secret manager (CI/CD).
# =============================================================================

NODE_ENV=development

# Safety: dry-run is always ON in development
DRY_RUN=true

# Low limits so dev runs finish quickly
DAILY_PROSPECT_LIMIT=5
DAILY_SEND_LIMIT=10

# Server
PORT=3001
AUTOMATION_SERVER_SECRET=dev-secret-change-in-prod

# Providers — fill in .env.local with your personal dev keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

APOLLO_API_KEY=
HUNTER_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_NAME=Dev — JARVIS PRIME
FROM_EMAIL=dev@jarvisprime.me
REPLY_TO_EMAIL=dev@jarvisprime.me

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#jarvis-dev

CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com
CALCOM_EVENT_TYPE_ID=0
CALCOM_BOOKING_URL=https://cal.com/jarvisprime/strategy-call

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata

CORS_ORIGINS=http://localhost:3000

COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Gurgaon, Haryana, India
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe

# Scoring & sequence defaults
DEFAULT_MAX_STEPS=3
DEFAULT_FOLLOWUP_DAYS=0,3,4
QUALIFY_THRESHOLD=15
HOT_THRESHOLD=24
