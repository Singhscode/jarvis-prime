{
  "app": {
    "name": "JARVIS PRIME",
    "version": "2.0.0",
    "environment": "development",
    "debug": false
  },
  "frontend": {
    "port": 3000,
    "host": "localhost",
    "apiUrl": "http://localhost:3001",
    "appUrl": "http://localhost:3000",
    "logLevel": "info",
    "enableAnalytics": true,
    "enableCrashReporting": false
  },
  "backend": {
    "port": 3001,
    "host": "0.0.0.0",
    "logLevel": "info",
    "logFormat": "json",
    "timeout": 30000
  },
  "database": {
    "poolSize": 20,
    "poolTimeout": 30000,
    "connectTimeout": 5000,
    "maxConnections": 100,
    "idleTimeout": 900000,
    "retries": 3,
    "retryDelay": 1000
  },
  "cache": {
    "provider": "redis",
    "ttl": 3600,
    "database": 0,
    "keyPrefix": "jarvis:"
  },
  "jwt": {
    "expiresIn": "7d",
    "refreshExpiresIn": "30d",
    "algorithm": "HS256"
  },
  "session": {
    "maxAge": 86400000,
    "resave": false,
    "saveUninitialized": false,
    "secure": false,
    "httpOnly": true,
    "sameSite": "lax"
  },
  "email": {
    "provider": "smtp",
    "from": "noreply@jarvisprime.com",
    "fromName": "JARVIS PRIME",
    "retries": 3,
    "timeout": 10000
  },
  "uploads": {
    "provider": "s3",
    "maxFileSize": 52428800,
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "application/pdf",
      "application/msword",
      "text/csv"
    ],
    "storagePath": "./storage/uploads"
  },
  "rateLimit": {
    "windowMs": 900000,
    "maxRequests": 100,
    "enabled": true,
    "skipSuccessfulRequests": false,
    "skipFailedRequests": false
  },
  "security": {
    "corsOrigins": ["http://localhost:3000"],
    "csrfProtection": true,
    "helmetEnabled": true,
    "rateLimitingEnabled": true,
    "forceHttps": false
  },
  "monitoring": {
    "logLevel": "info",
    "enableTracing": true,
    "enableMetrics": true,
    "metricsInterval": 60000,
    "tracesSampleRate": 0.1
  },
  "backgroundJobs": {
    "provider": "redis",
    "workers": 4,
    "timeout": 300000,
    "retryAttempts": 3,
    "retryDelay": 5000,
    "cronEnabled": true,
    "cronInterval": "*/5 * * * *"
  },
  "features": {
    "newDashboard": false,
    "betaApi": false,
    "advancedAnalytics": false,
    "enableBetaFeatures": false
  },
  "ai": {
    "model": "gpt-4",
    "temperature": 0.7,
    "maxTokens": 2000,
    "timeout": 30000,
    "retries": 2
  },
  "enrichment": {
    "providers": ["hunter", "apollo", "clearbit"],
    "parallelRequests": 5,
    "rateLimit": 100,
    "cacheResults": true,
    "cacheTtl": 86400
  },
  "pagination": {
    "defaultPageSize": 20,
    "maxPageSize": 100,
    "minPageSize": 1
  },
  "search": {
    "provider": "elasticsearch",
    "indexPrefix": "jarvis-prime",
    "queryTimeout": 10000,
    "maxResults": 10000
  },
  "notifications": {
    "emailEnabled": true,
    "slackEnabled": false,
    "webhooksEnabled": true,
    "retries": 3,
    "timeout": 10000
  },
  "auth": {
    "passwordMinLength": 8,
    "passwordRequireUppercase": true,
    "passwordRequireNumbers": true,
    "passwordRequireSpecialChars": true,
    "mfaEnabled": false,
    "sessionTimeout": 3600000,
    "rememberMeMaxAge": 2592000000
  },
  "api": {
    "version": "v1",
    "prefix": "/api",
    "documentation": "/api/docs",
    "timeout": 30000,
    "compression": true,
    "compressionThreshold": 1024
  },
  "logging": {
    "level": "info",
    "format": "json",
    "output": ["console"],
    "maxFileSize": "10m",
    "maxFiles": 14,
    "colorize": false
  },
  "deployment": {
    "environment": "development",
    "region": "us-east-1",
    "timezone": "UTC"
  }
}
