# ============================================================================
# JARVIS PRIME - Environment Configuration Template
# ============================================================================
# This file documents all environment variables used across the project.
# Copy to .env.local and fill in actual values for local development.
# Production values should be set via environment or secrets management.
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
APP_NAME=JARVIS PRIME
APP_VERSION=2.0.0

# ============================================================================
# FRONTEND (apps/web)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_LOG_LEVEL=debug

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=false

# ============================================================================
# BACKEND API (services/api)
# ============================================================================
API_PORT=3001
API_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jarvis_prime_dev
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30000

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ============================================================================
# AUTHENTICATION & AUTHORIZATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=30d

# OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400

# ============================================================================
# EMAIL & NOTIFICATIONS
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@jarvisprime.com
SMTP_FROM_NAME=JARVIS PRIME

# SendGrid (Alternative)
SENDGRID_API_KEY=

# Slack Notifications
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# GitHub Integration
GITHUB_API_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# LinkedIn Integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_TOKEN=

# OpenAI / AI Services
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_API_TIMEOUT=30000

# Data Enrichment Services
ENRICHMENT_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=

# ============================================================================
# BACKGROUND JOBS & QUEUES
# ============================================================================
QUEUE_PROVIDER=redis  # redis, bull, bee-queue
QUEUE_URL=redis://localhost:6379

# Job Workers
WORKER_THREADS=4
WORKER_TIMEOUT=300000
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_DELAY=5000

# Cron Jobs
ENABLE_CRON_JOBS=true
CRON_JOB_INTERVAL=*/5 * * * *

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text
LOG_OUTPUT=console,file  # console, file, both

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=0.1

# DataDog
DATADOG_API_KEY=
DATADOG_ENVIRONMENT=development
DATADOG_SERVICE_NAME=jarvis-prime

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_ID=

# ============================================================================
# STORAGE & FILES
# ============================================================================

# AWS S3 (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jarvis-prime-dev
AWS_S3_URL_PREFIX=https://jarvis-prime-dev.s3.amazonaws.com

# Google Cloud Storage (Alternative)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_KEY_FILE=

# Local File Storage
LOCAL_STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# ============================================================================
# SEARCH & INDEXING
# ============================================================================

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=jarvis-prime
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Algolia Search
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# API Security
CORS_ORIGIN=http://localhost:3000
API_KEY_HEADER=x-api-key
ENCRYPTION_KEY=your-32-character-encryption-key

# HTTPS & SSL
FORCE_HTTPS=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ============================================================================
# PAYMENT PROCESSING (If Applicable)
# ============================================================================

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Paddle
PADDLE_API_KEY=
PADDLE_VENDOR_ID=

# ============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================================================

# Vercel Deployment
VERCEL_ENV=development
VERCEL_URL=localhost:3000
VERCEL_GIT_PROVIDER=github
VERCEL_GIT_REPO_ID=

# Docker
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Kubernetes
K8S_NAMESPACE=jarvis-prime
K8S_REPLICAS=1

# ============================================================================
# FEATURE FLAGS & EXPERIMENTS
# ============================================================================

# LaunchDarkly
LAUNCHDARKLY_SDK_KEY=

# Growthbook
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

# Feature Toggles
FEATURE_FLAG_NEW_DASHBOARD=false
FEATURE_FLAG_BETA_API=false
FEATURE_FLAG_ADVANCED_ANALYTICS=false

# ============================================================================
# TESTING
# ============================================================================

# Test Database
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/jarvis_prime_test

# Test Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password-123

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Debug Mode
DEBUG=jarvis:*
VERBOSE=false

# Hot Reload
ENABLE_HOT_RELOAD=true
WATCH_MODE=true

# ============================================================================
# NOTES
# ============================================================================
# 
# Local Development (.env.local):
# - Copy this file and fill in your local values
# - .env.local is git-ignored, never commit it
#
# Staging (.env.staging):
# - Created during deployment
# - Contains staging-specific values
#
# Production (.env.production):
# - Never commit this file
# - Use environment variables or secrets management
# - Rotate secrets regularly
#
# Required vs Optional:
# - REQUIRED: DATABASE_URL, JWT_SECRET, NEXT_PUBLIC_API_URL
# - OPTIONAL: Analytics, external integrations, monitoring tools
#
# ============================================================================
