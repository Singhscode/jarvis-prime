# =============================================
# JARVIS PRIME — Agents Environment Variables
# Copy to .env and fill all values
# =============================================

# Supabase (same project as the site)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (used for lead classification + email drafting)
# Free alternative: use GROQ_API_KEY instead (14,400 req/day free)
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
# Set to "groq" to use Groq free tier, "openai" for OpenAI
AI_PROVIDER=groq

# Resend (email sending — 3000/mo free)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=JARVIS PRIME <hello@jarvis-prime.in>

# Telegram (alerts to founder)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321

# Apollo.io (lead scraping — free tier: 50 exports/mo)
APOLLO_API_KEY=your-apollo-api-key

# Founder info
FOUNDER_NAME=Anuj Singh
FOUNDER_EMAIL=anuj@jarvis-prime.in
FOUNDER_CALENDLY=https://calendly.com/your-link
