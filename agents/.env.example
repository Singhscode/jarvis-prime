# ============================================================================
# JARVIS PRIME — Environment Variables (REAL variable names used by the code)
# Copy to .env and fill with REAL credentials. Never commit .env.
# Run agents with: npm start  (uses node --env-file=.env)
# ============================================================================

# ── SUPABASE (database) ── REQUIRED
# https://supabase.com → Project → Settings → API
# Use the SERVICE ROLE key (server-side), NOT the anon key.
SUPABASE_URL=https://YOUR-REAL-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiI...

# ── AI ── REQUIRED (Groq is free: https://console.groq.com/keys)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Optional fallback if AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ── EMAIL ── REQUIRED (choose ONE)
# Option A: Gmail SMTP (easiest to start; use a Gmail App Password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Option B: Resend (better deliverability; verify your domain first)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=JARVIS PRIME <hello@jarvisprime.me>

# ── TELEGRAM (hot-lead alerts) ── recommended
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_CHAT_ID=123456789

# ── APOLLO (real prospect sourcing) ── REQUIRED for outbound lead-gen
# https://app.apollo.io → Settings → API. Needs email-export credits.
APOLLO_API_KEY=

# ── FOUNDER / BRAND ──
FOUNDER_NAME=Anuj Singh
FOUNDER_EMAIL=you@jarvisprime.me
FOUNDER_CALENDLY=https://calendly.com/your-username/30min
