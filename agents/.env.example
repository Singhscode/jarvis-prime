# ============================================================================
# JARVIS PRIME — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!
# ============================================================================

# SUPABASE (Database)
# Get from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OPENAI (AI for email drafting and intent classification)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# RESEND (Email sending)
# Get from: https://resend.com/api-keys
# Also verify your domain at: https://resend.com/domains
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@jarvisprime.me

# TELEGRAM (Real-time alerts)
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Start chat with your bot
# 3. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates → get chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# APOLLO.IO (Prospect data - optional)
# Get from: https://app.apollo.io → Settings → API Keys
APOLLO_API_KEY=

# FOUNDER INFO (Used in emails)
FOUNDER_NAME=Anuj
FOUNDER_CALENDLY=https://calendly.com/jarvis-prime/30min

# ============================================================================
# SETUP CHECKLIST:
# ============================================================================
# [ ] Create Supabase project and run schema.sql
# [ ] Create OpenAI account and add credits
# [ ] Create Resend account and verify domain
# [ ] Create Telegram bot and get chat ID
# [ ] (Optional) Create Apollo.io account for prospect data
# ============================================================================
