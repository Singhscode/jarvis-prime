# =============================================================================
# JARVIS PRIME ENGINE — PRODUCTION environment template
#
# THIS FILE CONTAINS NO REAL SECRETS — it is safe to commit.
# It documents every variable the engine needs in production.
#
# HOW TO USE:
#   Option A (Recommended): Copy to your secret manager (Doppler / AWS SSM /
#             Vercel env vars) and inject at deploy time via CI/CD.
#   Option B (Simple VPS):  Copy to server as /etc/jarvis/.env.production,
#             chmod 600, and point NODE_ENV=production.
#
# Do not leave any placeholder values — missing vars are caught by config.js
# on startup. The server will refuse to start if critical vars are absent.
# =============================================================================

NODE_ENV=production

# DRY_RUN must be false in production — set explicitly
DRY_RUN=false

# Adjust per deployment tier
DAILY_PROSPECT_LIMIT=500
DAILY_SEND_LIMIT=100

PORT=3001

# ⚠ Change this to a random 64-char string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_SERVER_SECRET=REPLACE_WITH_STRONG_SECRET

# Database
SUPABASE_URL=REPLACE_WITH_PRODUCTION_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRODUCTION_SUPABASE_KEY

# Sourcing
APOLLO_API_KEY=REPLACE_WITH_APOLLO_KEY
HUNTER_API_KEY=REPLACE_WITH_HUNTER_KEY

# AI
AI_PROVIDER=groq
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
FROM_NAME=Anuj from JARVIS PRIME
FROM_EMAIL=anuj@jarvisprime.me
REPLY_TO_EMAIL=anuj@jarvisprime.me

# Notifications
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK
SLACK_CHANNEL=#jarvis-alerts

# Calendar
CALCOM_API_KEY=REPLACE_WITH_CALCOM_KEY
CALCOM_BASE_URL=https://api.cal.com
CALCOM_EVENT_TYPE_ID=REPLACE_WITH_EVENT_TYPE_ID
CALCOM_BOOKING_URL=https://cal.com/jarvisprime/strategy-call

# LinkedIn (Phase 2B — optional for now)
LINKEDIN_COOKIE=
LINKEDIN_CSRF=
LINKEDIN_DAILY_CONNECTS=20
LINKEDIN_DAILY_DMS=30
LINKEDIN_DAILY_VIEWS=50

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata

# CORS — restrict to your exact production domain
CORS_ORIGINS=https://www.jarvisprime.me,https://jarvisprime.me

# Compliance
COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Gurgaon, Haryana, India
UNSUBSCRIBE_URL=https://www.jarvisprime.me/unsubscribe

# Scoring defaults
DEFAULT_MAX_STEPS=3
DEFAULT_FOLLOWUP_DAYS=0,3,4
QUALIFY_THRESHOLD=15
HOT_THRESHOLD=24
