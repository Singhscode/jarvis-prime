# ============================================================
# JARVIS PRIME ENGINE — Development Environment
# Used on your local machine during development
# DRY_RUN = true (safe mode, no real emails/API calls sent)
# ============================================================

NODE_ENV=development

# ---- SAFETY SWITCH -----------------------------------------
# true  = full pipeline runs but NO real emails or API calls
# false = goes LIVE (do NOT use in development)
DRY_RUN=true

# How many prospects to source per run (keep small in dev)
DAILY_PROSPECT_LIMIT=5
# How many emails to send per run (keep small in dev)
DAILY_SEND_LIMIT=0

# ---- DATABASE (Supabase) -----------------------------------
SUPABASE_URL=https://dev-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dev-service-role-key-here

# ---- PROSPECT SOURCING (optional in dev) -------------------
# Leave blank or use test keys for development
APOLLO_API_KEY=dev-apollo-key-here
HUNTER_API_KEY=dev-hunter-key-here

# ---- AI PERSONALIZATION ------------------------------------
GROQ_API_KEY=dev-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- EMAIL SENDING (disabled in DRY_RUN mode) --------------
RESEND_API_KEY=dev-resend-key-here
FROM_NAME=Anuj (DEV) from JARVIS PRIME
FROM_EMAIL=dev+anuj@jarvisprime.me
REPLY_TO_EMAIL=dev+replies@jarvisprime.me

# ---- ALERTS (optional) -------------------------------------
TELEGRAM_BOT_TOKEN=dev-bot-token-here
TELEGRAM_CHAT_ID=dev-chat-id-here

# ---- COMPLIANCE (development) -------------------------------
COMPANY_POSTAL_ADDRESS=JARVIS PRIME (DEV), Gurgaon, Haryana, India
UNSUBSCRIBE_URL=http://localhost:3001/unsubscribe

# ---- LOGGING -----------------------------------------------
LOG_LEVEL=debug
