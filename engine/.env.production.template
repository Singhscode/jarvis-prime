# ============================================================
# JARVIS PRIME ENGINE — Production Environment Template
# Add this to GitHub Environments > Production > Secrets
# NEVER commit actual values to this file
# ============================================================

NODE_ENV=production

# ---- SAFETY SWITCH -----------------------------------------
# MUST be false in production (enables real API calls)
# Only set this after testing staging deployment
DRY_RUN=false

# Production limits (adjust based on your requirements)
DAILY_PROSPECT_LIMIT=100
DAILY_SEND_LIMIT=150

# ---- DATABASE (Supabase production) -------------------------
SUPABASE_URL=https://prod-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=prod-service-role-key-here

# ---- PROSPECT SOURCING (production keys) --------------------
APOLLO_API_KEY=prod-apollo-key-here
HUNTER_API_KEY=prod-hunter-key-here

# ---- AI PERSONALIZATION (production keys) ------------------
GROQ_API_KEY=prod-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- EMAIL SENDING (production) ----------------------------
# CRITICAL: Domain must have SPF/DKIM/DMARC records configured
RESEND_API_KEY=prod-resend-key-here
FROM_NAME=Anuj from JARVIS PRIME
FROM_EMAIL=anuj@jarvisprime.me
REPLY_TO_EMAIL=anuj@jarvisprime.me

# ---- ALERTS (production bot) --------------------------------
TELEGRAM_BOT_TOKEN=prod-bot-token-here
TELEGRAM_CHAT_ID=prod-chat-id-here

# ---- COMPLIANCE (production) --------------------------------
COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Gurgaon, Haryana, India
UNSUBSCRIBE_URL=https://www.jarvisprime.me/unsubscribe

# ---- LOGGING -----------------------------------------------
LOG_LEVEL=warn
