# =============================================================================
# JARVIS PRIME ENGINE — Environment Variables Reference
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values for the providers you want to use.
# 3. Never commit .env — it is in .gitignore.
#
# Variables with a value already set here are safe defaults.
# Variables with an empty value (VAR=) are required to enable that feature.
# =============================================================================

# ---- Environment -----------------------------------------------------------
NODE_ENV=development

# ---- Safety switch ---------------------------------------------------------
# true  → full pipeline runs but NO emails are sent, NO paid APIs called.
# false → LIVE mode. Only set once your domain + keys are ready.
DRY_RUN=true

DAILY_PROSPECT_LIMIT=25
DAILY_SEND_LIMIT=40

# ---- API Server ------------------------------------------------------------
PORT=3001
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_SERVER_SECRET=dev-secret-change-me

# ---- Database (Supabase) ---------------------------------------------------
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Prospect Sourcing -----------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=

# ---- AI Personalization ----------------------------------------------------
# Select provider: 'groq' (fast, free tier) or 'openai'
AI_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Email Sending ---------------------------------------------------------
# Select provider: 'resend' or 'sendgrid'
EMAIL_PROVIDER=resend

RESEND_API_KEY=
# FROM_EMAIL must be on a domain you own with SPF/DKIM configured
FROM_NAME=Anuj from JARVIS PRIME
FROM_EMAIL=anuj@jarvisprime.me
REPLY_TO_EMAIL=anuj@jarvisprime.me

SENDGRID_API_KEY=

# ---- LinkedIn Automation (optional) ----------------------------------------
LINKEDIN_COOKIE=
LINKEDIN_CSRF=
LINKEDIN_DAILY_CONNECTS=20
LINKEDIN_DAILY_DMS=30
LINKEDIN_DAILY_VIEWS=50

# ---- Calendar (Cal.com) ----------------------------------------------------
CALCOM_API_KEY=
CALCOM_BASE_URL=https://api.cal.com
CALCOM_EVENT_TYPE_ID=
CALCOM_BOOKING_URL=https://cal.com/jarvisprime/strategy-call

# ---- Alerts (optional — pick one or more) ----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#jarvis-alerts

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ALERT_TO=

# ---- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---- Compliance (legally required for cold outreach) -----------------------
COMPANY_POSTAL_ADDRESS=JARVIS PRIME, Gurgaon, Haryana, India
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe

# ---- Outreach Defaults (overridable per-client via DB config) --------------
DEFAULT_MAX_STEPS=3
DEFAULT_FOLLOWUP_DAYS=0,3,4

# ---- Scoring Defaults (overridable per-client via DB config) ---------------
QUALIFY_THRESHOLD=15
HOT_THRESHOLD=24
SCORING_WEIGHT_TITLE=10
SCORING_WEIGHT_INDUSTRY=8
SCORING_WEIGHT_LOCATION=4
SCORING_WEIGHT_KEYWORD=2
SCORING_WEIGHT_EMAIL=2
